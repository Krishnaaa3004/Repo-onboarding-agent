# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GitHub personal access token (fine-grained, public repos read-only is enough)
GITHUB_TOKEN=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
# Max fresh (uncached) agent runs per IP per hour on the public API
RATE_LIMIT_PER_HOUR=8
